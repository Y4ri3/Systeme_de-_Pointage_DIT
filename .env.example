# =============================================================================
# Secrets Flask -- OBLIGATOIRES en production (le serveur refuse de demarrer
# sans eux si FLASK_CONFIG=production, voir config.py:ProductionConfig).
# En developpement, des valeurs par defaut de secours existent dans config.py,
# mais il est recommande de quand meme les renseigner ici.
# =============================================================================
# Cle de signature generale de l'application (sessions, tokens de reset password,
# tokens QR de pointage...). Genere-la avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_secret_key_now
# Cle de signature des JWT d'authentification. Peut etre differente de SECRET_KEY
# (recommande) ; si absente, retombe sur SECRET_KEY (voir config.py).
JWT_SECRET_KEY=change_this_jwt_secret_key_now

# =============================================================================
# Email (SMTP) -- optionnel en dev, recommande en production
# Utilise pour l'envoi du mot de passe temporaire a la creation d'un compte, et
# pour le lien de reinitialisation de mot de passe oublie. Sans ces variables,
# les comptes sont quand meme crees mais l'email n'est jamais envoye (l'API
# renvoie alors "email_sent": false) -- les emails sont juste loggues en local.
# =============================================================================
# Compte SMTP Gmail (serveur/port geres directement dans config.py). Utiliser un
# "mot de passe d'application" Gmail (pas le mot de passe du compte), genere depuis
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=ton_email@gmail.com
MAIL_PASSWORD=ton_app_password_gmail

# =============================================================================
# Reconnaissance faciale ARSA Face (https://faceapi.arsa.technology)
# Sans ARSA_FACE_API_KEY, /attendance/kiosk/scan, /kiosk/checkin et le pointage
# facial deprecie renvoient 503 (service non configure) -- le reste de l'API
# (auth, cours, absences, admin, pointage QR) fonctionne normalement sans ca.
# =============================================================================
# Cle secrete du compte ARSA Face (dashboard ARSA, header x-key-secret cote API).
ARSA_FACE_API_KEY=ton_api_key_arsa_face
# URL de base de l'API ARSA Face. A changer seulement si ARSA fournit une autre
# URL (ex. environnement dedie) -- sinon garder la valeur par defaut.
ARSA_FACE_BASE_URL=https://faceapi.arsa.technology/api/v1
# Seuil de similarite (0-1) au-dessus duquel deux visages sont consideres comme
# la meme personne (POST /face_recognition/validate_faces, champ similarity_score).
ARSA_FACE_MATCH_THRESHOLD=0.8
# Seuil de vivacite (0-1) au-dessus duquel un visage est considere reel et non
# une photo/ecran (POST /face_liveness, champ liveness_confidence).
ARSA_FACE_LIVENESS_THRESHOLD=0.7
# Delai maximum (secondes) avant de considerer l'API ARSA Face indisponible.
ARSA_FACE_TIMEOUT_SECONDS=20

# =============================================================================
# Borne de pointage (kiosk) -- OBLIGATOIRES en production
# =============================================================================
# Cle secrete partagee par la tablette de pointage (header X-Attendance-Kiosk-Key),
# alternative a un JWT staff pour /attendance/kiosk/scan et /kiosk/checkin.
# Genere-la avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
ATTENDANCE_KIOSK_API_KEY=cle_secrete_de_la_borne_de_pointage
# CIDR (separes par des virgules) autorises a appeler /attendance/kiosk/scan,
# /kiosk/checkin ET /etudiant/attendance/checkin-qr (VLAN/VPN dedie aux tablettes
# et aux etudiants sur place). Toute requete hors de ces plages recoit
# 403 kiosk_network_forbidden, meme avec un JWT ou une cle valides.
# Vide (comme ci-dessous) = restriction desactivee, pratique en developpement local.
KIOSK_ALLOWED_NETWORKS=10.50.0.0/24
# Nombre de reverse proxies de confiance devant Flask (nginx, load balancer...),
# pour que request.remote_addr reflete la vraie IP cliente via X-Forwarded-For au
# lieu de celle du proxy. 0 = connexion directe sans proxy (dev local).
TRUSTED_PROXY_HOPS=1

# =============================================================================
# Suivi de presence en temps reel (SSE) -- OBLIGATOIRE en production
# =============================================================================
# URL Redis utilisee comme pub/sub partage entre les workers Gunicorn pour le
# flux SSE de suivi de presence (GET /professeur/courses/:id/attendance/stream).
# Sans elle, le flux retombe sur un registre en memoire local au process, qui ne
# fonctionne correctement qu'avec un seul worker -- acceptable en developpement,
# pas en production multi-workers.
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Frontend / CORS
# =============================================================================
# URL de la page front (React) qui affiche le formulaire "nouveau mot de passe",
# suffixee automatiquement de ?token=... dans le lien envoye par email.
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Origines autorisees a appeler l'API (separees par des virgules) -- doit
# correspondre exactement a l'URL du frontend (schema + host + port).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# Stockage des fichiers uploades (photos de profil) -- optionnel
# Par defaut : dossier "uploads" a la racine du projet. Decommenter pour changer
# d'emplacement (ex. volume monte separement en production).
# =============================================================================
# UPLOAD_FOLDER=/chemin/absolu/vers/uploads

# =============================================================================
# PostgreSQL -- utilise seulement si tu lances `docker compose up -d db` (ou la
# stack complete `docker compose up --build`) ; par defaut ce projet tourne en
# local avec SQLite (voir instance/dev.db), DATABASE_URL reste alors commentee.
# =============================================================================
POSTGRES_USER=pointage_user
POSTGRES_PASSWORD=change_this_password_now
POSTGRES_DB=pointage_dev
POSTGRES_PORT=5432

# Decommenter pour forcer l'utilisation de PostgreSQL au lieu de SQLite en local
# (necessite `docker compose up -d db` prealable) ; toujours definie et pointant
# vers une vraie base PostgreSQL en production.
# DATABASE_URL=postgresql://pointage_user:change_this_password_now@localhost:5432/pointage_dev